<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>net.eterneon.telamon.settings</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Telamon Settings</name>
  <summary>Set up your computer</summary>
  <description>
    <p>Settings is where Telamon OS is set up: Wi-Fi and network, Bluetooth, displays, sound, appearance, the desktop and dock, notifications, power, users, date and time, language, keyboard, mouse and touchpad, printers, default apps, app permissions, privacy, updates and system information.</p>
    <p>It changes the system through its own services and their permission prompts, and opens Plasma's settings modules for anything it has no page for.</p>
  </description>
  <launchable type="desktop-id">net.eterneon.telamon.settings.desktop</launchable>
  <url type="homepage">https://github.com/EternalCoder454/AtlasOS</url>
  <url type="vcs-browser">https://github.com/EternalCoder454/atlasos-settings</url>
  <url type="bugtracker">https://github.com/EternalCoder454/atlasos-settings/issues</url>
  <developer id="net.eterneon">
    <name>Eterneon</name>
  </developer>
  <categories>
    <category>Settings</category>
  </categories>
  <provides>
    <binary>telamon-settings</binary>
    <binary>atlas-settings</binary>
  </provides>
  <content_rating type="oars-1.1"/>
