[Desktop Entry]
Type=Application
Name=Telamon Settings
GenericName=System Settings
Comment=Set up Wi-Fi, displays, sound, appearance and more
Exec=telamon-settings
Icon=net.eterneon.telamon.settings
Terminal=false
Categories=Qt;KDE;Settings;
# What people type to find it, and what each page is called, so the Launcher
# (and any menu search) finds Settings by any of them.
Keywords=settings;system settings;preferences;options;configuration;configure;control panel;control center;wifi;wi-fi;network;internet;ethernet;vpn;bluetooth;devices;printer;display;displays;monitor;screen;resolution;night light;sound;audio;volume;speaker;microphone;keyboard;mouse;touchpad;shortcuts;appearance;theme;dark mode;wallpaper;accent;dock;notifications;apps;default apps;startup;privacy;security;firewall;permissions;users;accounts;password;power;battery;sleep;accessibility;time;date;language;region;update;updates;about;
StartupNotify=true
SingleMainWindow=true
X-KDE-StartupNotify=true
# The Launcher's deep links (ActivateAction) start it through the session bus
# when it is not running (net.eterneon.telamon.settings.service).
DBusActivatable=true
