[Desktop Entry]
Type=Application
Name=Telamon Settings
GenericName=System Settings
Comment=Set up Wi-Fi, displays, sound, appearance and more
Exec=telamon-settings
Icon=net.eterneon.telamon.settings
Terminal=false
Categories=Qt;KDE;Settings;
Keywords=settings;preferences;configuration;control center;system settings;wifi;network;bluetooth;display;sound;appearance;wallpaper;power;users;keyboard;mouse;
StartupNotify=true
SingleMainWindow=true
X-KDE-StartupNotify=true
# Hidden until Settings replaces System Settings in the image (the Telamon OS
# session's cutover); until then it is installed for testing only.
NoDisplay=true
